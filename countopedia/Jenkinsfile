pipeline {

    agent any

    stages {

        stage('Install Dependencies') {
            steps {
                dir('countopedia') {
                    bat 'npm ci'
                }
            }
        }

        stage('Build') {
            steps {
                dir('countopedia') {
                    bat 'npm run build'
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('countopedia') {
                    script {

                        if (env.BRANCH_NAME == 'dev') {

                            bat "docker build -t countopedia:dev-%BUILD_NUMBER% ."

                        } else if (env.BRANCH_NAME == 'test') {

                            bat "docker build -t countopedia:test-%BUILD_NUMBER% ."

                        } else if (env.BRANCH_NAME == 'stage') {

                            bat "docker build -t countopedia:stage-%BUILD_NUMBER% ."

                        } else if (env.BRANCH_NAME == 'main') {

                            bat "docker build -t countopedia:prod-%BUILD_NUMBER% ."

                        } else if (env.BRANCH_NAME == 'release/CICD') {

                            bat "docker build -t countopedia:release-%BUILD_NUMBER% ."

                        } else {

                            echo "No Docker build configuration for branch: ${env.BRANCH_NAME}"

                        }
                    }
                }
            }
        }

        stage('Deploy Environment') {
            steps {
                script {

                    if (env.BRANCH_NAME == 'dev') {

                        bat '''
                            docker stop countopedia-dev || echo Container does not exist
                            docker rm countopedia-dev || echo Container does not exist
                            docker run -d --name countopedia-dev -p 8081:80 countopedia:dev-%BUILD_NUMBER%
                        '''

                    } else if (env.BRANCH_NAME == 'test') {

                        bat '''
                            docker stop countopedia-test || echo Container does not exist
                            docker rm countopedia-test || echo Container does not exist
                            docker run -d --name countopedia-test -p 8082:80 countopedia:test-%BUILD_NUMBER%
                        '''

                    } else if (env.BRANCH_NAME == 'stage') {

                        bat '''
                            docker stop countopedia-stage || echo Container does not exist
                            docker rm countopedia-stage || echo Container does not exist
                            docker run -d --name countopedia-stage -p 8083:80 countopedia:stage-%BUILD_NUMBER%
                        '''

                    } else if (env.BRANCH_NAME == 'main') {

                        bat '''
                            docker stop countopedia-prod || echo Container does not exist
                            docker rm countopedia-prod || echo Container does not exist
                            docker run -d --name countopedia-prod -p 8080:80 countopedia:prod-%BUILD_NUMBER%
                        '''

                    } else if (env.BRANCH_NAME == 'release/CICD') {

                        bat '''
                            docker stop countopedia-release || echo Container does not exist
                            docker rm countopedia-release || echo Container does not exist
                            docker run -d --name countopedia-release -p 8084:80 countopedia:release-%BUILD_NUMBER%
                        '''

                    } else {

                        echo "No deployment configuration for branch: ${env.BRANCH_NAME}"

                    }
                }
            }
        }
    }
}
